# Typesense Cloud (https://cloud.typesense.org)
# Admin API key — server-side only (seed script). Never commit or put in the browser.
TYPESENSE_HOST=xxx.a1.typesense.net
TYPESENSE_PORT=443
TYPESENSE_PROTOCOL=https
TYPESENSE_ADMIN_API_KEY=your_admin_api_key_here

# Optional: defaults to "products"
TYPESENSE_COLLECTION=products
